From ec08e70eb003332bb44819b199e853f2ff1f9b06 Mon Sep 17 00:00:00 2001
From: Regent Dev <dev@regentplatform.com>
Date: Sun, 23 Aug 2026 15:23:41 +0000
Subject: [PATCH] fix: accept NEXT_PUBLIC_POSTHOG_KEY as PostHog token fallback
 (Vercel Marketplace integration naming)

---
 instrumentation-client.ts | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/instrumentation-client.ts b/instrumentation-client.ts
index 03d20dd..b6ac2fc 100644
--- a/instrumentation-client.ts
+++ b/instrumentation-client.ts
@@ -1,12 +1,14 @@
 import posthog from "posthog-js";
 
-const posthogProjectToken = process.env.NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN;
+const posthogProjectToken =
+  process.env.NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN ||
+  process.env.NEXT_PUBLIC_POSTHOG_KEY;
 const posthogHost = process.env.NEXT_PUBLIC_POSTHOG_HOST;
 
 if (!posthogProjectToken) {
   if (process.env.NODE_ENV === "development") {
     throw new Error(
-      "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN variable required by PostHog is missing or un-configured, this causes events to be silently missed. This error stops appearing once NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN is configured",
+      "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN (or NEXT_PUBLIC_POSTHOG_KEY) variable required by PostHog is missing or un-configured, this causes events to be silently missed. This error stops appearing once it is configured",
     );
   }
 } else if (!posthogHost) {
-- 

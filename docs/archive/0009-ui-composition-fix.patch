 app/globals.css                   | 11 +++++-
 components/dashboard/StatCard.tsx | 58 ++++++++++++++-----------------
 components/layouts/AppSidebar.tsx | 47 ++++++++++++++++++-------
 components/ui/card.tsx            |  2 +-
 4 files changed, 72 insertions(+), 46 deletions(-)

diff --git a/app/globals.css b/app/globals.css
index 7cb1253..a1264cf 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -42,7 +42,7 @@
     --input: 43 11% 88%;
     --ring: 211 55% 23%;
 

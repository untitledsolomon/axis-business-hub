NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Paddle Configuration
# Client-side token for Paddle.js (Developer Tools > Authentication in Paddle dashboard)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
# "sandbox" or "production" - controls which Paddle environment Paddle.js talks to
NEXT_PUBLIC_PADDLE_ENV=production
# Server-side API key, used only in the webhook route (never exposed to the client)
PADDLE_API_KEY=your-paddle-api-key
# Webhook signing secret from Paddle Dashboard > Developer Tools > Notifications
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret

# Paddle price IDs for each plan (fake placeholders only; replace with your own real IDs in the actual env file)
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=pri_your_starter_monthly_price_id
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEARLY=pri_your_starter_yearly_price_id
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_your_pro_monthly_price_id
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=pri_your_pro_yearly_price_id
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTHLY=pri_your_advanced_monthly_price_id
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEARLY=pri_your_advanced_yearly_price_id

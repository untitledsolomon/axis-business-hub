NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# RevenueCat Configuration (Web Billing SDK public API key, starts with "rcb_")
NEXT_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-web-billing-api-key

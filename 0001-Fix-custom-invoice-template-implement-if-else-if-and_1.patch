From 84a9e2d6f2f3e1274fc517aeb8c81b864d98d11c Mon Sep 17 00:00:00 2001
From: Assistant <assistant@regent.local>
Date: Tue, 25 Aug 2026 14:26:51 +0000
Subject: [PATCH] Fix custom invoice template: implement
 {{#if}}/{{else}}/{{/if}} and add client.phone field

- interpolateTemplate never handled {{#if}}...{{else}}...{{/if}} blocks,
  causing both branches (logo and fallback name) to render simultaneously
  in custom templates.
- client.phone was missing from InvoicePdfData, fieldValues(), and the
  edge function's data mapping, so {{client.phone}} always rendered blank.
- Added phone to the settings preview's sample client data to satisfy
  the updated InvoicePdfData type.
---
 .../settings/OrganisationSettingsView.tsx     |  2 +-
 lib/invoicing/templates/interpolate.ts        | 22 +++++++++++++++++--
 lib/invoicing/templates/types.ts              |  2 +-
 .../functions/generate-invoice-pdf/index.ts   |  2 +-
 4 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/components/settings/OrganisationSettingsView.tsx b/components/settings/OrganisationSettingsView.tsx
index aa67fdb..5fe93ed 100644
--- a/components/settings/OrganisationSettingsView.tsx
+++ b/components/settings/OrganisationSettingsView.tsx
@@ -112,7 +112,7 @@ export function OrganisationSettingsView() {
     const data: InvoicePdfData = {
       org: { name: org?.name ?? "Organisation", logo_url: values.logo_url || org?.logo_url || null, address: org?.address ?? null, brand_color: values.invoice_brand_color },
       invoice: { number: "PREVIEW-001", issue_date: new Date().toISOString().slice(0, 10), due_date: new Date().toISOString().slice(0, 10), currency: org?.base_currency ?? "UGX", notes: "Thank you for your business." },
-      client: { name: "Sample Client", company_name: "Sample Company", email: "client@example.com" },
+      client: { name: "Sample Client", company_name: "Sample Company", email: "client@example.com", phone: "+256 700 000000" },
       items: [{ description: "Sample service", quantity: 2, unit_price_cents: 25000, total_cents: 50000 }],
       totals: { subtotal_cents: 50000, discount_cents: 0, tax_cents: 0, grand_total_cents: 50000 },
     };
diff --git a/lib/invoicing/templates/interpolate.ts b/lib/invoicing/templates/interpolate.ts
index b8e2562..ed6cc2b 100644
--- a/lib/invoicing/templates/interpolate.ts
+++ b/lib/invoicing/templates/interpolate.ts
@@ -12,16 +12,34 @@ const fieldValues = (data: InvoicePdfData) => ({
   "org.name": data.org.name, "org.logo_url": data.org.logo_url, "org.address": data.org.address,
   "invoice.number": data.invoice.number, "invoice.issue_date": data.invoice.issue_date,
   "invoice.due_date": data.invoice.due_date, "invoice.notes": data.invoice.notes,
-  "client.name": data.client.name, "client.company_name": data.client.company_name, "client.email": data.client.email,
+  "client.name": data.client.name, "client.company_name": data.client.company_name, "client.email": data.client.email, "client.phone": data.client.phone,
   "totals.subtotal": money(data.totals.subtotal_cents, data.invoice.currency),
   "totals.tax": money(data.totals.tax_cents, data.invoice.currency),
   "totals.discount": money(data.totals.discount_cents, data.invoice.currency),
   "totals.grand_total": money(data.totals.grand_total_cents, data.invoice.currency),
 });
 
+function resolveConditionals(html: string, values: Record<string, string | null | undefined>): string {
+  // Handles {{#if field}}truthy{{else}}falsy{{/if}} and {{#if field}}truthy{{/if}}
+  // Non-greedy match, run repeatedly to support sibling (not nested) conditionals.
+  const ifRe = /\{\{#if\s+([\w.]+)\}\}([\s\S]*?)(?:\{\{else\}\}([\s\S]*?))?\{\{\/if\}\}/;
+  let result = html;
+  let guard = 0;
+  while (ifRe.test(result) && guard < 100) {
+    result = result.replace(ifRe, (_match, key: string, truthyBlock: string, falsyBlock = "") => {
+      const val = values[key];
+      const isTruthy = val !== null && val !== undefined && val !== "";
+      return isTruthy ? truthyBlock : falsyBlock;
+    });
+    guard++;
+  }
+  return result;
+}
+
 export function interpolateTemplate(html: string, data: InvoicePdfData): string {
   const values = fieldValues(data);
-  const withItems = html.replace(/\{\{#each items\}\}([\s\S]*?)\{\{\/each\}\}/g, (_, block: string) =>
+  const withConditionals = resolveConditionals(html, values);
+  const withItems = withConditionals.replace(/\{\{#each items\}\}([\s\S]*?)\{\{\/each\}\}/g, (_, block: string) =>
     data.items.map((item) => block.replace(/\{\{\s*(description|quantity|unit_price|total)\s*\}\}/g, (_match, key: string) =>
       escapeHtml(key === "description" ? item.description : key === "quantity" ? item.quantity : key === "unit_price" ? money(item.unit_price_cents, data.invoice.currency) : money(item.total_cents, data.invoice.currency))
     )).join("")

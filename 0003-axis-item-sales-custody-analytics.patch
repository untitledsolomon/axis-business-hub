+              className="w-full bg-axis-blue hover:bg-axis-blue-light"
+              disabled={createDailySale.isPending}
+            >
+              {createDailySale.isPending ? "Logging…" : "Log Sale"}
+            </Button>
+          </form>
+        </Form>
+      )}
+    </div>
   );
 }

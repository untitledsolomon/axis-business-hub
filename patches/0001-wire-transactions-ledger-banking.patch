+                          <span className="sr-only">Open menu for {transaction.description}</span>
+                        </Button>
+                      </DropdownMenuTrigger>
+                      <DropdownMenuContent align="end">
+                        <DropdownMenuLabel>Actions</DropdownMenuLabel>
+                        <DropdownMenuItem>View Journal Entry</DropdownMenuItem>
